local found = false

local function CheckForKrystalDance()
    for _, obj in ipairs(game:GetDescendants()) do
        if string.lower(obj.Name) == "krystaldance" then
            return obj
        end
    end

    return nil
end

while not found do
    local model = CheckForKrystalDance()

    if model then
        found = true
        break
    end

    task.wait(0.15)
end

