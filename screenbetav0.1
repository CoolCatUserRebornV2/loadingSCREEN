    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 0)),
    ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 120)),
    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 210, 0)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 240, 80)),
    ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 170, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 230, 40))
})
RingGradient.Parent = Ring

local RingRotationConnection

RingRotationConnection = RunService.RenderStepped:Connect(function(dt)
    if not Ring.Parent then
        RingRotationConnection:Disconnect()
        return
    end

    RingGradient.Rotation = (RingGradient.Rotation + dt * 180) % 360
end)

local function tween(object, time, properties, easingStyle, easingDirection)
    local info = TweenInfo.new(
        time,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )

    local t = TweenService:Create(object, info, properties)
    t:Play()
    return t
end

Image.Size = UDim2.fromOffset(850, 850)
